#!/bin/sh
# Commit-message guard. This is the exact place the leak happened once:
# the file diff was clean, the message carried a real street address.
#
# A commit message is published verbatim and is far harder to retract than a
# file, because rewriting history does not remove the old object from GitHub.

root=$(git rev-parse --show-toplevel) || exit 1

if command -v python3 >/dev/null 2>&1; then
  py=python3
elif command -v python >/dev/null 2>&1; then
  py=python
else
  exit 0
fi

exec "$py" "$root/tools/lint_staged.py" --message-only --message-file "$1"
